# Neon Postgres — filled in by `neon deploy` / `neon env pull`
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full

# Neon Object Storage (bucket "assets" in neon.ts) — filled in by `neon deploy`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Signs admin session cookies — generate with: openssl rand -base64 48
AUTH_SECRET=

# Site — the live domain, no trailing slash. Used for canonical URLs,
# hreflang, the sitemap and structured data, so it must be right in production.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Google Search Console "HTML tag" verification code (content="…" value only)
GOOGLE_SITE_VERIFICATION=
